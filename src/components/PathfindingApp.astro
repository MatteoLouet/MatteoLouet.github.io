---
/**
 * L'application « Paris Pathfinding » intégrée à la page (logique : src/viz/pathfinding.ts).
 * Toujours sombre, comme l'original : rues blanches sur fond noir.
 */
import type { Lang } from '../i18n';
interface Props { lang: Lang; places: { key: string; label: string; lat: number; lon: number }[] }
const { lang, places } = Astro.props;
const t = (fr: string, en: string) => (lang === 'fr' ? fr : en);
const ALGOS = [
  { k: 'dijkstra', n: 'Dijkstra', c: 'rgb(34,211,238)' },
  { k: 'astar', n: 'A*', c: 'rgb(244,114,182)' },
  { k: 'greedy', n: t('Glouton', 'Greedy'), c: 'rgb(251,191,36)' },
  { k: 'bfs', n: 'BFS', c: 'rgb(74,222,128)' },
];
---
<div class="pfa" data-pathfinding data-lang={lang} data-places={JSON.stringify(places)} data-base="/data/paris/">
  <div class="pfa__map">
    <canvas data-canvas aria-label={t('Carte du réseau de rues de Paris. Cliquez pour placer le départ puis l’arrivée.', 'Map of the Paris street network. Click to place the start, then the destination.')}></canvas>
    <p class="pfa__hint" data-hint aria-live="polite"></p>
    <div class="pfa__zoom">
      <button type="button" data-zoom-in aria-label={t('Zoomer', 'Zoom in')}>+</button>
      <button type="button" data-zoom-out aria-label={t('Dézoomer', 'Zoom out')}>−</button>
      <button type="button" data-zoom-reset aria-label={t('Voir tout Paris', 'Show all of Paris')}>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
      </button>
    </div>
    <div class="pfa__counter" data-counter hidden></div>
    <p class="pfa__status" data-status></p>
  </div>

  <aside class="pfa__panel">
    <header>
      <p class="pfa__title">Paris <span>Pathfinding</span></p>
      <p class="pfa__sub">{t('Comparer les algorithmes de plus court chemin sur les vraies rues de Paris', 'Compare shortest-path algorithms on the real streets of Paris')}</p>
    </header>

    <div class="pfa__bloc pfa__ab">
      <label class="pfa__field"><span class="pfa__pin pfa__pin--a">A</span>
        <select data-a aria-label={t('Départ', 'Start')}>
          <option value="" disabled selected>{t('Départ (ou clic sur la carte)', 'Start (or click the map)')}</option>
          {places.map((p) => <option value={p.key}>{p.label}</option>)}
        </select>
      </label>
      <button type="button" class="pfa__swap" data-swap aria-label={t('Inverser départ et arrivée', 'Swap start and destination')}>
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M5 2v12M5 14l-3-3M5 14l3-3M11 14V2M11 2 8 5M11 2l3 3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <label class="pfa__field"><span class="pfa__pin pfa__pin--b">B</span>
        <select data-b aria-label={t('Arrivée', 'Destination')}>
          <option value="" disabled selected>{t('Arrivée (ou clic sur la carte)', 'Destination (or click the map)')}</option>
          {places.map((p) => <option value={p.key}>{p.label}</option>)}
        </select>
      </label>
    </div>

    <div class="pfa__bloc">
      <p class="pfa__label" id="pfa-mode">{t('Mode de transport', 'Transport mode')}</p>
      <div class="pfa__seg" role="group" aria-labelledby="pfa-mode">
        <button type="button" data-mode="pied" aria-pressed="true">{t('À pied', 'Walking')}</button>
        <button type="button" data-mode="velo" aria-pressed="false">{t('Vélo', 'Cycling')}</button>
        <button type="button" data-mode="voiture" aria-pressed="false">{t('Voiture', 'Car')}</button>
      </div>
      <p class="pfa__note" data-note></p>
    </div>

    <div class="pfa__bloc">
      <p class="pfa__label" id="pfa-algo">{t('Algorithme animé', 'Animated algorithm')}</p>
      <div class="pfa__seg pfa__seg--algos" role="group" aria-labelledby="pfa-algo">
        {ALGOS.map((a, i) => <button type="button" data-algo={a.k} aria-pressed={i === 0 ? 'true' : 'false'}><i style={`--c:${a.c}`}></i>{a.n}</button>)}
        <button type="button" data-algo="tous" aria-pressed="false"><i class="pfa__multi"></i>{t('Tous', 'All')}</button>
      </div>
      <label class="pfa__label pfa__speed">{t('Vitesse d’animation', 'Animation speed')} <output data-speed-out>×1</output>
        <input type="range" data-speed min="-3" max="3" step="1" value="0" />
      </label>
    </div>

    <button type="button" class="pfa__run" data-run disabled>{t('Calculer l’itinéraire', 'Compute the route')}</button>

    <div class="pfa__results" data-results hidden>
      <p class="pfa__label">{t('Comparaison', 'Comparison')} <span class="pfa__note" data-critere></span></p>
      <table>
        <thead><tr><th>Algo</th><th>{t('Distance', 'Distance')}</th><th>{t('Durée', 'Time')}</th><th>{t('Explorés', 'Explored')}</th><th>{t('Calcul', 'Compute')}</th><th>{t('Écart', 'Gap')}</th></tr></thead>
        <tbody></tbody>
      </table>
      <p class="pfa__note">{t('Cliquez sur une ligne pour rejouer l’animation de cet algorithme.', 'Click a row to replay that algorithm’s animation.')}</p>
    </div>
  </aside>
</div>

<script>
  import { mountPathfinding } from '../viz/pathfinding';
  const root = document.querySelector<HTMLElement>('[data-pathfinding]');
  if (root) mountPathfinding(root);
</script>

<style>
  /* Toujours sombre, quel que soit le thème du site (palette de l'application d'origine) */
  .pfa {
    --bg: #000; --panel: #0b0b0c; --line: #26262b; --txt: #f4f4f5; --dim: #a1a1aa;
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 380px;
    background: var(--bg); color: var(--txt); font-family: var(--f-text); color-scheme: dark;
    min-height: min(82vh, 780px);
  }
  .pfa__map { position: relative; min-height: 420px; }
  .pfa__map canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: crosshair; touch-action: none; }
  .pfa__hint { position: absolute; left: 16px; top: 14px; font-size: 13px; color: var(--dim); background: rgb(0 0 0 / 0.6); padding: 6px 10px; pointer-events: none; }
  .pfa__status { position: absolute; left: 16px; bottom: 12px; font-family: var(--f-mono); font-size: 12px; color: var(--dim); background: rgb(0 0 0 / 0.7); padding: 4px 8px; pointer-events: none; }
  .pfa__status:empty { display: none; }
  .pfa__counter { position: absolute; right: 16px; top: 14px; font-family: var(--f-mono); font-size: 12px; background: rgb(0 0 0 / 0.72); border: 1px solid var(--line); padding: 8px 12px; display: grid; gap: 4px; }
  .pfa__counter[hidden] { display: none; }
  .pfa__zoom { position: absolute; right: 16px; bottom: 12px; display: grid; gap: 4px; }
  .pfa__zoom button { width: 36px; height: 36px; display: grid; place-items: center; background: var(--panel); color: var(--txt); border: 1px solid var(--line); font-size: 18px; cursor: pointer; }
  .pfa__zoom button:hover { border-color: var(--txt); }

  .pfa__panel { background: var(--panel); border-left: 1px solid var(--line); padding: 22px 22px 26px; display: flex; flex-direction: column; gap: 18px; overflow: auto; }
  .pfa__title { font-family: var(--f-display); font-size: 26px; font-weight: 650; letter-spacing: -0.02em; }
  .pfa__title span { color: rgb(34,211,238); }
  .pfa__sub { font-size: 13px; color: var(--dim); margin-top: 4px; line-height: 1.4; }
  .pfa__bloc { display: flex; flex-direction: column; gap: 8px; }
  .pfa__ab { display: grid; grid-template-columns: 1fr; gap: 6px; position: relative; }
  .pfa__field { display: grid; grid-template-columns: 26px 1fr; align-items: center; gap: 8px; }
  .pfa__field select { width: 100%; min-width: 0; background: #141416; color: var(--txt); border: 1px solid var(--line); padding: 9px 10px; font: inherit; font-size: 14px; }
  .pfa__pin { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: 11px; font-weight: 700; color: #000; }
  .pfa__pin--a { background: rgb(52,211,153); }
  .pfa__pin--b { background: rgb(248,113,113); }
  .pfa__swap { justify-self: end; width: 32px; height: 28px; display: grid; place-items: center; background: none; color: var(--dim); border: 1px solid var(--line); cursor: pointer; }
  .pfa__swap:hover { color: var(--txt); }
  .pfa__label { font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--dim); font-family: var(--f-mono); }
  .pfa__seg { display: flex; flex-wrap: wrap; gap: 4px; }
  .pfa__seg button { flex: 1 1 auto; display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 36px; padding: 6px 10px; background: #141416; color: var(--dim); border: 1px solid var(--line); font: inherit; font-size: 13px; cursor: pointer; }
  .pfa__seg button[aria-pressed="true"] { color: var(--txt); border-color: var(--txt); background: #1c1c20; }
  .pfa__seg i { width: 9px; height: 9px; border-radius: 50%; background: var(--c); }
  .pfa__multi { background: conic-gradient(rgb(34,211,238) 0 25%, rgb(244,114,182) 0 50%, rgb(251,191,36) 0 75%, rgb(74,222,128) 0) !important; }
  .pfa__note { font-size: 12px; color: var(--dim); line-height: 1.4; text-transform: none; letter-spacing: 0; font-family: var(--f-text); }
  .pfa__speed { display: grid; grid-template-columns: 1fr auto; gap: 6px 10px; align-items: center; margin-top: 4px; }
  .pfa__speed input { grid-column: 1 / -1; accent-color: rgb(34,211,238); }
  .pfa__speed output { color: var(--txt); }
  .pfa__run { min-height: 44px; background: rgb(34,211,238); color: #000; border: 0; font: inherit; font-weight: 600; font-size: 15px; cursor: pointer; }
  .pfa__run:disabled { opacity: 0.4; cursor: not-allowed; }
  .pfa__results table { width: 100%; border-collapse: collapse; font-size: 12px; margin-top: 6px; font-variant-numeric: tabular-nums; }
  .pfa__results th { text-align: left; font-weight: 500; color: var(--dim); padding: 6px 4px; border-bottom: 1px solid var(--line); }
  .pfa__results :global(td) { padding: 7px 4px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .pfa__results :global(td i) { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
  .pfa__results :global(tr) { cursor: pointer; }
  .pfa__results :global(tr:hover), .pfa__results :global(tr.is-on) { background: #1c1c20; }
  .pfa__results :global(.pf-ok) { color: rgb(74,222,128); }
  .pfa__results :global(.pf-ko) { color: rgb(251,191,36); }
  .pfa :global(button:focus-visible), .pfa :global(select:focus-visible), .pfa :global(tr:focus-visible) { outline: 2px solid rgb(34,211,238); outline-offset: 2px; }

  @media (max-width: 1024px) {
    .pfa { grid-template-columns: 1fr; min-height: 0; }
    .pfa__map { height: 62vh; min-height: 380px; }
    .pfa__panel { border-left: 0; border-top: 1px solid var(--line); }
  }
</style>
