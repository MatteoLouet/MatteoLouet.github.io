---
/**
 * Explorateur intégré à l'étude de cas ANFR (logique : src/viz/anfr.ts).
 * Reprend deux pages du tableau de bord Streamlit : « Qui contrôle ? » (carte par type de
 * propriétaire) et « Territoires » (indice de dépendance à poids réglables).
 */
import data from '../data/anfr.json';
import type { Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (fr: string, en: string) => (lang === 'fr' ? fr : en);
const CAT: Record<string, [string, string]> = {
  'TowerCo': ['TowerCo', 'TowerCo'],
  'Opérateur (en propre)': ['Opérateur (en propre)', 'Operator (own site)'],
  'Acteur public': ['Acteur public', 'Public body'],
  'Transport et énergie': ['Transport et énergie', 'Transport & energy'],
  'Privés et particuliers': ['Privés et particuliers', 'Private owners'],
};
const COUL = ['#315C9B', '#CC1505', '#3F8A4E', '#C99A1E', '#B9B5AC'];
const loc = lang === 'fr' ? 'fr-FR' : 'en-GB';
const pc = (v: number) => (lang === 'fr' ? `${Math.round(v * 100)}\u00a0%` : `${Math.round(v * 100)}%`);
const W = [
  { k: 'hhi', l: t('Concentration (HHI)', 'Concentration (HHI)') },
  { k: 'top1_part', l: t('Poids du 1er propriétaire', 'Largest owner’s share') },
  { k: 'communes_mono', l: t('Communes captives', 'Captive communes') },
  { k: 'quatre_ops', l: t('Sites à 4 opérateurs', '4-operator sites') },
];
const CATS = data.categories as Record<string, number>;
const deps = [...data.departements].sort((a, b) => a.nom.localeCompare(b.nom, 'fr'));
---
<div class="ax" data-anfr data-lang={lang} data-src="/data/anfr/supports.bin.gz"
  data-deps={JSON.stringify(data.departements)} data-carte={JSON.stringify(data.carte)}>
  <div class="ax__map">
    <canvas data-canvas aria-label={t('Carte des supports d’antennes de France métropolitaine, colorés par type de propriétaire. Cliquez pour choisir un département.', 'Map of mobile antenna sites in metropolitan France, coloured by owner type. Click to pick a département.')}></canvas>
    <p class="ax__label" data-label aria-live="polite"></p>
    <p class="ax__status" data-status></p>
    <div class="ax__legend" role="group" aria-label={t('Types de propriétaires', 'Owner types')}>
      {data.carte.categories.map((c, i) => (
        <button type="button" data-cat={i} aria-pressed="true"><i style={`background:${COUL[i]}`}></i>{t(CAT[c][0], CAT[c][1])} <span class="tnum">{pc(CATS[c])}</span></button>
      ))}
    </div>
  </div>

  <aside class="ax__panel">
    <div>
      <p class="ax__h">{t('Indice de dépendance', 'Dependency index')}</p>
      <p class="ax__note">{t('Quatre composantes, ramenées de 0 (département le moins exposé) à 1 (le plus exposé), puis moyennées. Réglez leur poids :', 'Four components, scaled from 0 (least exposed département) to 1 (most exposed), then averaged. Set their weights:')}</p>
      <div class="ax__w">
        {W.map((w) => (
          <label><span>{w.l}</span><output>1</output><input type="range" min="0" max="5" step="1" value="1" data-w={w.k} /></label>
        ))}
      </div>
    </div>
    <div>
      <p class="ax__h">{t('Les 10 plus exposés', 'The 10 most exposed')}</p>
      <ol class="ax__rank" data-rank></ol>
      <label class="ax__sel"><span class="ax__note">{t('Ou choisir un département', 'Or pick a département')}</span>
        <select data-select>
          <option value="">—</option>
          {deps.map((d) => <option value={d.dep}>{d.nom} ({d.dep})</option>)}
        </select>
      </label>
    </div>
    <div class="ax__card" data-card aria-live="polite"></div>
  </aside>
</div>

<script>
  import { mountAnfr } from '../viz/anfr';
  const root = document.querySelector<HTMLElement>('[data-anfr]');
  if (root) mountAnfr(root);
</script>

<style>
  .ax { display: grid; grid-template-columns: minmax(0, 1fr) 360px; background: var(--paper); min-height: min(86vh, 820px); }
  .ax__map { position: relative; min-height: 460px; }
  .ax__map canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; cursor: pointer; }
  .ax__label { position: absolute; left: 16px; top: 14px; font-family: var(--f-display); font-weight: 600; font-size: 20px; pointer-events: none; }
  .ax__status { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--f-mono); font-size: 12px; color: var(--ink-2); pointer-events: none; }
  .ax__status:empty { display: none; }
  .ax__legend { position: absolute; left: 12px; bottom: 12px; display: flex; flex-wrap: wrap; gap: 4px; max-width: calc(100% - 24px); }
  .ax__legend button { display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 4px 10px; background: var(--paper); border: 1px solid var(--rule); color: var(--ink); font: inherit; font-size: 12px; cursor: pointer; }
  .ax__legend button[aria-pressed="false"] { opacity: 0.45; }
  .ax__legend button:hover { border-color: var(--ink); }
  .ax__legend i { width: 9px; height: 9px; border-radius: 50%; }
  .ax__legend span { color: var(--ink-2); }

  .ax__panel { border-left: 1px solid var(--ink); padding: 20px 20px 24px; display: flex; flex-direction: column; gap: 22px; background: var(--paper-2); }
  .ax__h { font-family: var(--f-mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-2); margin-bottom: 8px; }
  .ax__note { font-size: 13px; color: var(--ink-2); line-height: 1.45; }
  .ax__w { display: grid; gap: 8px; margin-top: 10px; }
  .ax__w label { display: grid; grid-template-columns: 1fr auto; gap: 2px 10px; font-size: 13px; }
  .ax__w input { grid-column: 1 / -1; width: 100%; accent-color: var(--accent); }
  .ax__w output { font-family: var(--f-mono); font-size: 12px; }

  .ax__rank { list-style: none; display: grid; gap: 2px; }
  .ax__rank :global(button) { width: 100%; display: grid; grid-template-columns: 2.2ch minmax(0, 1fr) 70px 4ch; gap: 8px; align-items: center; padding: 5px 6px; background: none; border: 0; border-bottom: 1px solid var(--rule); color: var(--ink); font: inherit; font-size: 13px; text-align: left; cursor: pointer; min-height: 32px; }
  .ax__rank :global(button:hover), .ax__rank :global(button[aria-pressed="true"]) { background: var(--paper); }
  .ax__rank :global(button[aria-pressed="true"] .ax__n) { color: var(--accent-ink); font-weight: 600; }
  .ax__rank :global(.ax__r) { color: var(--ink-3); font-size: 12px; }
  .ax__rank :global(.ax__n) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ax__rank :global(.ax__bar) { height: 8px; background: var(--rule); }
  .ax__rank :global(.ax__bar span) { display: block; height: 100%; background: var(--ink); }
  .ax__rank :global(.ax__v) { text-align: right; font-size: 12px; }
  .ax__sel { display: grid; gap: 4px; margin-top: 12px; }
  .ax__sel select { background: var(--paper); color: var(--ink); border: 1px solid var(--ink-3); padding: 8px; font: inherit; font-size: 14px; }

  .ax__card { border-top: 1px solid var(--ink); padding-top: 12px; }
  .ax__card :global(.ax__hint) { font-size: 13px; color: var(--ink-2); }
  .ax__card :global(.ax__dn) { font-family: var(--f-display); font-weight: 600; font-size: 20px; }
  .ax__card :global(.ax__dn span) { font-family: var(--f-mono); font-size: 12px; color: var(--ink-2); font-weight: 400; }
  .ax__card :global(.ax__big) { font-size: 30px; font-family: var(--f-display); font-weight: 600; color: var(--accent-ink); margin: 2px 0 8px; }
  .ax__card :global(.ax__big small) { font-size: 12px; font-family: var(--f-mono); color: var(--ink-2); font-weight: 400; }
  .ax__card :global(.ax__kv) { display: grid; gap: 4px; font-size: 13px; }
  .ax__card :global(.ax__kv div) { display: grid; grid-template-columns: 1fr auto; gap: 10px; border-bottom: 1px solid var(--rule); padding-block: 3px; }
  .ax__card :global(.ax__kv dt) { color: var(--ink-2); }
  .ax__card :global(.ax__kv dd) { text-align: right; }
  .ax :global(button:focus-visible), .ax :global(select:focus-visible), .ax :global(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (max-width: 1024px) {
    .ax { grid-template-columns: 1fr; min-height: 0; }
    .ax__map { height: 72vh; min-height: 420px; }
    .ax__panel { border-left: 0; border-top: 1px solid var(--ink); }
  }
</style>
