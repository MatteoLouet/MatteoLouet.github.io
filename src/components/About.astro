---
import { languages, interests } from '../data/skills';
import { pick, type Lang } from '../i18n';
import { site } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (fr: string, en: string) => (lang === 'fr' ? fr : en);
---
<section class="section about" id="profil" data-section={t('Profil', 'About')} aria-labelledby="about-title">
  <div class="wrap">
    <header class="sec-head g12">
      <h2 class="h2 sec-title" id="about-title">{t('Profil', 'About')}</h2>
    </header>

    <div class="g12 about__body">
      <figure class="pcard" style="box-sizing:border-box;width:100%;max-width:200px;margin:0;padding:0;border:0;background:none;justify-self:start;align-self:start">
        <img class="pcard__img" src="/images/profil/portrait.jpg?v=3" width="800" height="1000" decoding="async" style="display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover" alt={t('Portrait de Mattéo Louet, en costume sombre et cravate, sur fond gris', 'Portrait of Mattéo Louet in a dark suit and tie, on a grey background')} />
        <figcaption class="pcard__cap meta meta--ink2" style="display:flex;justify-content:space-between;gap:8px;margin-top:8px"><span>Mattéo Louet</span><span>Paris</span></figcaption>
      </figure>

      <div class="about__text prose">
        {lang === 'fr' ? (
          <>
            <p class="lead">Actuellement étudiant en quatrième année à l’Efrei Paris, j’étudie l’ingénierie en combinant un enseignement approfondi en mathématiques, physique et informatique, que j’applique lors de mon alternance au Commissariat des armées en tant que Data Analyst.</p>
            <p>Ma formation m’apporte continuellement de nouvelles compétences techniques grâce à une approche pluridisciplinaire. J’ai également l’occasion d’aiguiser mon esprit critique grâce à des analyses variées et de développer mes compétences en communication. Je suis sérieux et j’ai une bonne capacité d’adaptation. Après l’obtention de mon diplôme en 2028, je compte poursuivre une carrière dans le domaine de l’ingénierie, en France ou à l’étranger.</p>
            <p>Toujours en apprentissage, je m’attache à enrichir mes compétences et à bâtir un réseau professionnel solide pour mieux appréhender les enjeux du secteur.</p>
          </>
        ) : (
          <>
            <p class="lead">Currently a fourth-year student at Efrei Paris, I study engineering through in-depth teaching in mathematics, physics and computer science, which I apply in my work-study position as a Data Analyst at the French Armed Forces Commissariat.</p>
            <p>My degree keeps bringing me new technical skills through a multidisciplinary approach. It also lets me sharpen my critical thinking through a wide range of analyses and develop my communication skills. I am serious and I adapt well. After graduating in 2028, I plan to pursue a career in engineering, in France or abroad.</p>
            <p>Always learning, I work at broadening my skills and building a strong professional network to better understand the challenges of the field.</p>
          </>
        )}
      </div>

      <dl class="about__sheet">
        <div><dt class="meta meta--ink2">{t('Langues', 'Languages')}</dt><dd>{languages.map((l) => <span>{pick(l.name, lang)} <span class="muted">· {pick(l.level, lang)}</span></span>)}</dd></div>
        <div><dt class="meta meta--ink2">{t('Activités', 'Activities')}</dt><dd>{interests.map((i) => <span>{pick(i, lang)}</span>)}</dd></div>
        <div><dt class="meta meta--ink2">{t('Mobilité', 'Mobility')}</dt><dd><span>{t('Permis B', 'Driving licence (B)')}</span></dd></div>
        <div><dt class="meta meta--ink2">CV</dt><dd><a class="link" href={site.contact.cv} download="Matteo-Louet-CV.pdf">{t('Télécharger le CV', 'Download the CV')} (PDF) ↓</a></dd></div>
      </dl>
    </div>

  </div>
</section>

<style>
  .about__body { row-gap: var(--s-5); align-items: start; }
  /* Portrait : petit encadré (styles de base en ligne sur l'élément, pour résister au cache du navigateur) */
  .pcard { grid-column: 1 / span 3; }
  .about__text { grid-column: 4 / span 6; padding-left: var(--gutter); }
  .about__text .lead { margin-bottom: 1em; }
  .about__sheet { grid-column: 10 / -1; border-top: 1px solid var(--ink); }
  .about__sheet > div { padding-block: 10px 12px; border-bottom: 1px solid var(--rule); }
  .about__sheet dd { display: flex; flex-direction: column; margin-top: 4px; font-size: 14px; line-height: 1.45; }


  @media (max-width: 1024px) {
    .pcard { grid-column: 1 / span 3; }
    .about__text { grid-column: 4 / -1; }
    .about__sheet { grid-column: 4 / -1; }
  }
  @media (max-width: 640px) {
    .pcard { grid-column: 1 / -1; }
    .about__text, .about__sheet { grid-column: 1 / -1; padding-left: 0; }
  }
</style>
